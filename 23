s = input("Enter a string: ")
if not s:
    print("Output: ")
else:
    encoded = []
    count = 1
    for i in range(1, len(s)):
        if s[i] == s[i - 1]:
            count += 1
        else:
            encoded.append(f"{s[i-1]}{count}")
            count = 1
    encoded.append(f"{s[-1]}{count}")
    compressed = "".join(encoded)
    print(f"Output: {compressed if len(compressed) < len(s) else s}")